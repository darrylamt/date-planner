{
  "expo": {
    "name": "aduro",
    "slug": "aduro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aduro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.darrylamt.aduro",
      "infoPlist": {
        "NSCalendarsUsageDescription": "aduro adds your date plan to your calendar so you don't lose track of the evening.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "aduro adds your date plan to your calendar so you don't lose track of the evening.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "maps",
          "comgooglemaps",
          "tel",
          "whatsapp",
          "maps",
          "comgooglemaps",
          "tel"
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ],
        "NSPhotoLibraryUsageDescription": "aduro uses this to set your profile picture. Photos stay on your device unless you pick one."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.darrylamt.aduro",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "aduro adds your date plan to your calendar so you don't lose track of the evening."
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "aduro uses this to set your profile picture."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "DateNight",
            "ios": "./assets/app-icons/date_night.png",
            "android": {
              "foregroundImage": "./assets/app-icons/date_night.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "FirstDate",
            "ios": "./assets/app-icons/first_date.png",
            "android": {
              "foregroundImage": "./assets/app-icons/first_date.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "Anniversary",
            "ios": "./assets/app-icons/anniversary.png",
            "android": {
              "foregroundImage": "./assets/app-icons/anniversary.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "Birthday",
            "ios": "./assets/app-icons/birthday.png",
            "android": {
              "foregroundImage": "./assets/app-icons/birthday.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "Graduation",
            "ios": "./assets/app-icons/graduation.png",
            "android": {
              "foregroundImage": "./assets/app-icons/graduation.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "Celebration",
            "ios": "./assets/app-icons/celebration.png",
            "android": {
              "foregroundImage": "./assets/app-icons/celebration.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "Friends",
            "ios": "./assets/app-icons/friend_outing.png",
            "android": {
              "foregroundImage": "./assets/app-icons/friend_outing.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "SoloDay",
            "ios": "./assets/app-icons/solo_day.png",
            "android": {
              "foregroundImage": "./assets/app-icons/solo_day.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05671085-4481-486e-b052-1cf91c28fd79"
      }
    },
    "owner": "darryl_amt",
    "updates": {
      "url": "https://u.expo.dev/05671085-4481-486e-b052-1cf91c28fd79"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
