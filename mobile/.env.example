# Copy to .env.local and fill in. Expo inlines EXPO_PUBLIC_* at build time.

# Supabase — publishable client credentials (safe to ship; RLS protects data).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Deployed web app that serves /api/generate and /api/swap.
EXPO_PUBLIC_API_URL=https://your-app.vercel.app
