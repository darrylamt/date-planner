# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL + anon key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — used to serve shared plan links by slug).
# NEVER expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic ─────────────────────────────────────────────────────────────
# Itinerary generation (claude-sonnet-4-6). Server-side only.
ANTHROPIC_API_KEY=sk-ant-...
